<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_gold_loyalty" model="mail.template">
            <field name="name">Loyalty - Weekend Cupom Gold</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Special Thanks + Your VIP Coupon!</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Hello <strong><t t-out="object.name"/></strong>,</p>
                    <p>Thank you very much for being a customer. <strong>Gold</strong>!</p>
                    <p>Here is your exclusive mock discount coupon for this week.:</p>
                    <div style="padding: 15px; background: #fff3cd; border: 1px solid #ffeba1; text-align: center; font-size: 18px; font-weight: bold; color: #856404; margin: 15px 0;">
                        CUPOM VIP: GOLD-SUNDAY-SPECIAL
                    </div>
                    <p>Best regards,<br/>Sales Team</p>
                </div>
            </field>
        </record>
    </data>
</odoo>