<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View loyalty.program form -->
    <record id="view_loyalty_program_form" model="ir.ui.view">
        <field name="name">view.loyalty.program.form</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="after">
                <field name='use_order_total_for_points'/>
            </xpath>
        </field>
    </record>
</odoo>