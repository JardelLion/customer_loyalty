<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="customer_loyalty.LoyaltyPointsWidget">
        <div class="d-inline-flex align-items-center p-2 rounded bg-view border border-primary shadow-sm">
            <img t-att-src="levelImage" 
                 t-att-alt="loyaltyLevel" 
                 class="me-2" 
                 style="width: 38px; height: 38px; object-fit: contain;"/>
            <div>
                <span class="fw-bold d-block text-primary">
                    <t t-esc="totalPoints"/> Points
                </span>
                <small class="text-muted fw-semibold">
                    Level: <t t-esc="loyaltyLevel"/>
                </small>
            </div>
        </div>
    </t>
</templates>